# Copy to .env and fill in. Never commit .env.

# --- Mode: paper (simulated, default) | testnet | mainnet (real money)
HL_MODE=paper
HL_COINS=BTC,ETH,SOL

# --- Hyperliquid keys (testnet/mainnet only)
# Use an API wallet key (app.hyperliquid.xyz -> More -> API): it can trade but cannot withdraw.
HL_PRIVATE_KEY=
# Address of the main account the API wallet trades for.
HL_ACCOUNT_ADDRESS=
# Unattended mainnet runs (Docker) need this instead of the --live flag.
HL_CONFIRM_MAINNET=no

# --- LLM for the agent (DeepSeek by default; any OpenAI-compatible API works)
DEEPSEEK_API_KEY=
HL_LLM_BASE_URL=https://api.deepseek.com
HL_AGENT_MODEL=deepseek-v4-pro
# Thinking effort: low | high | max. Leave empty to send nothing.
HL_AGENT_EFFORT=high

# --- Hard risk limits (the agent cannot exceed these)
HL_MAX_LEVERAGE=3
HL_MAX_POSITION_PCT=100
HL_MAX_DAILY_LOSS_PCT=5
HL_MAX_DRAWDOWN_PCT=20
HL_MAX_TRADES_PER_DAY=20
HL_DEFAULT_STOP_LOSS_PCT=3
HL_MAX_STOP_LOSS_PCT=10

# --- Costs used by backtests and paper trading
HL_TAKER_FEE=0.00045
HL_SLIPPAGE_BPS=2
HL_PAPER_EQUITY=10000

# --- Autopilot research window
HL_RESEARCH_DAYS=180
HL_RESEARCH_INTERVALS=1h,4h

# --- Simulation realism (paper mode and `hyperbot simulate`)
# Multiplier on the market-impact estimate: 0 = off, 1 = standard, 2 = pessimistic.
HL_SIM_IMPACT=1
HL_SIM_IMPACT_HALFLIFE_MIN=30

# --- HTTP API (`hyperbot api`). Required when listening on anything but localhost.
HL_API_TOKEN=

# --- LLM prices, USD per 1M tokens, used to subtract AI cost from profit.
# Defaults are deepseek-v4-pro peak rates (off-peak is half). Change them if you change model.
HL_LLM_PRICE_INPUT=1.32
HL_LLM_PRICE_INPUT_CACHED=0.044
HL_LLM_PRICE_OUTPUT=3.96

# --- Autopilot exposure. 1 = playbook weights as written. Small accounts may need
# more so orders clear Hyperliquid's $10 minimum; HL_MAX_LEVERAGE still caps it.
HL_EXPOSURE_MULTIPLIER=1

# --- Output budget per model call (reasoning tokens count toward it).
HL_AGENT_MAX_TOKENS=32000

# --- Point the MCP server at a running bot (e.g. your cloud deployment) instead of a local copy.
# With this set, `hyperbot mcp` forwards everything to that bot's API using HL_API_TOKEN.
HL_REMOTE_URL=

# --- Universe. fixed = trade only HL_COINS. auto = HL_COINS are the core, and the bot also
# scans the exchange and researches the busiest and fastest-moving other liquid perps.
HL_UNIVERSE=fixed
HL_UNIVERSE_SIZE=5
HL_MIN_VOLUME_USD=5000000
# Per-coin cap (% of equity) for coins outside HL_COINS.
HL_MAX_ALT_POSITION_PCT=150

# --- Who sets the risk limits. With HL_AI_SETS_LIMITS=yes the AI manager can change the
# leverage cap, daily-loss limit, drawdown halt, stop rules etc. itself, inside fixed outer
# bounds in hyperbot/risk.py (LIMIT_BOUNDS). The HL_MAX_* values above are then only the start.
HL_AI_SETS_LIMITS=no
HL_REQUIRE_STOP=yes

# --- Trailing used when a trade does not set its own: this many times its stop distance, for both
# the trailing stop and the move to break-even. 0 = none. 2 roughly matched a plain stop in backtests
# while stopping a big winner from coming all the way back; 1 cut trend returns sharply.
HL_DEFAULT_TRAIL_MULT=0

# --- Extra AI review when profit or loss has moved this many percent of equity since the last review
# (at most one unscheduled review per half hour). 0 = scheduled reviews and stop-outs only.
HL_REVIEW_MOVE_PCT=3

# --- Owner's cap on trailing: every position trails at most this many percent behind its best price
# and moves to break-even once this far in profit. The AI may set tighter values, never wider or off.
# 0 = no cap (the AI chooses). Tight caps lock gains sooner but cut trend strategies short.
HL_MAX_TRAIL_PCT=0
